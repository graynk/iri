<!DOCTYPE html>
<html lang="en" data-theme={IriWeb.Theme.normalize(assigns[:theme])}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content={IriWeb.Theme.color(assigns[:theme])} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="IRI" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <.live_title default="IRI" suffix=" · Your game library" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/iri-icon.svg"} />
    <link rel="icon" type="image/png" sizes="192x192" href={~p"/images/iri-icon-192.png"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/iri-icon-180.png"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-slate-950 antialiased">
    {@inner_content}
  </body>
</html>
